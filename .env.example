# ==========================================================
# TaniChain - Root Environment Configuration
# Copy this file to .env before running `docker compose up --build`
# ==========================================================

# --- PostgreSQL ---
POSTGRES_USER=tanichain
POSTGRES_PASSWORD=tanichain_password
POSTGRES_DB=tanichain

# --- Backend ---
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d
WALLET_ENCRYPTION_KEY=replace_this_with_a_long_random_encryption_passphrase

# --- Stellar Testnet ---
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org
STELLAR_EXPLORER_BASE_URL=https://stellar.expert/explorer/testnet

# --- CORS ---
CORS_ORIGIN=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api
