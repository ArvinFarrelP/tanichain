// TaniChain - Prisma Schema
// Transparent Agricultural Payment Network powered by Stellar

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FARMER
  BUYER
  COOPERATIVE
  ADMIN
}

enum ProductStatus {
  AVAILABLE
  SOLD_OUT
  ARCHIVED
}

enum OrderStatus {
  PENDING
  COMMITTED
  ESCROW_LOCKED
  DELIVERED
  CONFIRMED
  PAID
  CANCELLED
  DISPUTED
}

enum TransactionType {
  WALLET_FUNDING
  PAYMENT_COMMITMENT
  ESCROW_DEPOSIT
  ESCROW_RELEASE
  REFUND
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum NotificationType {
  PAYMENT_CREATED
  PAYMENT_CONFIRMED
  PAYMENT_RELEASED
  ORDER_UPDATE
  SYSTEM
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  fullName      String
  phone         String?
  role          Role     @default(BUYER)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  wallet        Wallet?
  products      Product[]        @relation("FarmerProducts")
  ordersAsBuyer Order[]          @relation("BuyerOrders")
  notifications Notification[]
  activityLogs  ActivityLog[]

  @@map("users")
}

model Wallet {
  id                String   @id @default(uuid())
  userId            String   @unique
  publicKey         String   @unique
  encryptedSecret   String
  network           String   @default("TESTNET")
  isFunded          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model Product {
  id            String        @id @default(uuid())
  farmerId      String
  name          String
  description   String?
  category      String?
  quantity      Float
  unit          String        @default("kg")
  pricePerUnit  Float
  harvestDate   DateTime?
  imageUrl      String?
  status        ProductStatus @default(AVAILABLE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  farmer        User          @relation("FarmerProducts", fields: [farmerId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@map("products")
  @@index([farmerId])
  @@index([status])
}

model Order {
  id                  String      @id @default(uuid())
  buyerId             String
  productId           String
  quantity            Float
  totalAmount         Float
  status              OrderStatus @default(PENDING)
  deliveryConfirmedAt DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  buyer               User               @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  product             Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  paymentCommitment   PaymentCommitment?
  transactions        Transaction[]

  @@map("orders")
  @@index([buyerId])
  @@index([productId])
  @@index([status])
}

model PaymentCommitment {
  id              String      @id @default(uuid())
  orderId         String      @unique
  buyerPublicKey  String
  farmerPublicKey String
  amount          Float
  memo            String?
  stellarTxHash   String?
  escrowLocked    Boolean     @default(false)
  releasedAt      DateTime?
  status          OrderStatus @default(COMMITTED)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payment_commitments")
}

model Transaction {
  id              String             @id @default(uuid())
  orderId         String?
  type            TransactionType
  status          TransactionStatus  @default(PENDING)
  senderPublicKey String
  receiverPublicKey String
  amount          Float
  assetCode       String             @default("XLM")
  memo            String?
  stellarTxHash   String?            @unique
  explorerUrl     String?
  ledger          Int?
  createdAt       DateTime           @default(now())

  order           Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@map("transactions")
  @@index([senderPublicKey])
  @@index([receiverPublicKey])
  @@index([status])
  @@index([orderId])
}

model EscrowWallet {
  id              String   @id @default(uuid())
  name            String   @unique @default("platform_escrow")
  publicKey       String   @unique
  encryptedSecret String
  isFunded        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("escrow_wallets")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("activity_logs")
  @@index([userId])
  @@index([action])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
  @@index([userId])
}
