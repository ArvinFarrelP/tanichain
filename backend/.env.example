# Server
NODE_ENV=development
PORT=4000

# Database (matches docker-compose service name "postgres")
DATABASE_URL=postgresql://tanichain:tanichain_password@postgres:5432/tanichain?schema=public

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Wallet encryption (used to encrypt Stellar secret keys at rest)
WALLET_ENCRYPTION_KEY=replace_this_with_a_long_random_encryption_passphrase

# Stellar Testnet
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org
STELLAR_EXPLORER_BASE_URL=https://stellar.expert/explorer/testnet

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
